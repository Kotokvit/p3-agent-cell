# ════════════════════════════════════════════════════════════════
# P3 Bridge Configuration Template
# Copy this file to ~/.p3/config.env and fill in your values
# ════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────

# GitHub Classic PAT with 'repo' and 'gist' scopes
# Generate at: https://github.com/settings/tokens
P3_GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ── Security ───────────────────────────────────────────────────

# Shared secret for HMAC signing + channel encryption
# Both AI side and PC side MUST use the same secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
P3_SECRET=

# Security mode: "blacklist" (block dangerous) or "whitelist" (only allow safe)
P3_SECURITY_MODE=blacklist

# Max commands per minute (rate limiting)
P3_RATE_LIMIT=30

# ── Repository ────────────────────────────────────────────────

# GitHub repo for relay (owner/repo format)
P3_REPO_OWNER=Kotokvit
P3_REPO_NAME=p3-agent-cell

# Relay path within the repo
P3_RELAY_PATH=relay

# ── PC Configuration ──────────────────────────────────────────

# Default working directory for command execution
P3_ENGINE_DIR=

# Audit log directory
P3_AUDIT_DIR=/var/log/p3-bridge

# ── Sandbox (Optional) ────────────────────────────────────────

# Set to "1" to enable Docker sandbox execution
P3_SANDBOX_ENABLED=0

# Docker sandbox directory
P3_SANDBOX_DIR=

# ── Tunnel (Optional, Future) ─────────────────────────────────

# Direct HTTP tunnel URL (bypasses GitHub relay for lower latency)
P3_TUNNEL_URL=
