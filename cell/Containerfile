FROM archlinux:latest

# Metadata
LABEL maintainer="P3-Agent-Cell"
LABEL description="Isolated root-access container for AI agents"

# Fix mirrors (CachyOS uses own mirrors, Arch base image needs proper ones)
RUN pacman -Sy --noconfirm archlinux-keyring && \
    pacman -S --noconfirm --needed \
    # Base system
    base-devel sudo git curl wget \
    # Python ecosystem
    python python-pip python-virtualenv \
    # Zig compiler
    # (installed manually below since not in official repos) \
    # Dev tools
    gcc gfortran cmake make pkg-config \
    # Network tools
    openssh rsync \
    # GPU support (CUDA toolkit)
    # (nvidia-container-toolkit handles device passthrough from host) \
    # Utilities
    htop vim nano tmux jq \
    && pacman -Sc --noconfirm

# Create agent user with full sudo (NOPASSWD)
RUN useradd -m -s /bin/bash agent && \
    echo "agent ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    echo "root ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Working directory for agent
RUN mkdir -p /workspace && chown agent:agent /workspace
WORKDIR /workspace

# Install Zig (latest)
RUN curl -L https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz -o /tmp/zig.tar.xz && \
    tar -xf /tmp/zig.tar.xz -C /opt && \
    ln -s /opt/zig-linux-x86_64-0.14.0/zig /usr/local/bin/zig && \
    rm /tmp/zig.tar.xz

# Install conda (miniforge - community conda)
RUN curl -L https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -o /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p /opt/conda && \
    ln -s /opt/conda/bin/conda /usr/local/bin/conda && \
    ln -s /opt/conda/bin/mamba /usr/local/bin/mamba && \
    rm /tmp/miniforge.sh && \
    chown -R agent:agent /opt/conda

# Environment
ENV PATH="/opt/conda/bin:/usr/local/bin:/usr/bin:${PATH}"
ENV HOME="/workspace"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Switch to agent user
USER agent

# Entry point: keep container alive
CMD ["sleep", "infinity"]

